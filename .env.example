# Recommended for reliable Solana mainnet reads and transaction submission.
# Use a private server-side RPC endpoint from Helius or another Solana provider.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Optional fallback used only when all live SOL/USD price sources are unavailable.
SOL_USD_PRICE=150

# Used by the website only when the always-running relay is not configured.
PUMPPORTAL_API_KEY=

# Website-to-relay connection. Keep the secret server-side and use the same
# random value for PUMPPORTAL_RELAY_SECRET and LOCKSTEP_RELAY_SECRET.
PUMPPORTAL_RELAY_URL=https://YOUR-RELAY-HOST
PUMPPORTAL_RELAY_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
